        <mxCell id="ext_notif" value="[External API] Notification Providers&#xa;- SendGrid / Twilio / Firebase FCM&#xa;- Transactional SMS and Email Dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;align=center;" vertex="1" parent="box_ext">
          <mxGeometry x="20" y="300" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="telemetry" value="[Telemetry] SRE Observability Stack&#xa;- Prometheus and Grafana (Metrics)&#xa;- OpenTelemetry and Jaeger (Tracing)&#xa;- Centralized Structured Logs&#xa;- PagerDuty Alert Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;fontColor=#14532d;align=left;spacingLeft=15;" vertex="1" parent="box_ext">
          <mxGeometry x="20" y="440" width="250" height="120" as="geometry" />
        </mxCell>

